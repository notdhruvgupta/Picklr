# Copy to .env.local and fill in.
#
# Local development: run `npm run db:start`, then copy API_URL and PUBLISHABLE_KEY
# from `npx supabase status -o env`.
# Hosted: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Only needed to run `npm run referee:create`. Never commit or expose it.
SUPABASE_SECRET_KEY=

# The referee account `npm run referee:create` creates (or resets the password of).
REFEREE_EMAIL=
REFEREE_PASSWORD=
